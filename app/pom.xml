<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.cdpai</groupId>
        <artifactId>cdpai-gate-parent</artifactId>
        <version>0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cdpai-gate</artifactId>
    <packaging>jar</packaging>

    <properties>
        <main.class>cdpai.gate.GateMain</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.cdpai</groupId>
            <artifactId>cdpai-gate-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-toml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.luvml</groupId>
            <artifactId>luvjfx</artifactId>
            <version>${luvjfx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dustinredmond.fxtrayicon</groupId>
            <artifactId>FXTrayIcon</artifactId>
            <version>${fxtrayicon.version}</version>
        </dependency>
        <!-- Windows-only: this whole app module is Win32-specific (named pipes, PEB reads),
             so the classifier pulls in the platform natives the plain (classifier-less)
             artifact does not ship. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
    </dependencies>

    <build>
        <finalName>cdpgate</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- cdpgate.exe, a jr launcher (github.com/jarrunner/jr) with its config baked in, built by
         jr-maven-plugin (on Maven Central). Opt-in, so a plain build stays a plain jar build:
             mvn -Djrexe package                      an exe that runs the jar just built (target/jr)
             mvn -Djrexe -Djr.installDir=<dir> package    and copies it to <dir>
             mvn -Djrexe -Djr.source=url package      a release exe: fetches its jar from this version's
                                                      GitHub release, checked against the sha256 it carries
         The embedded config cannot be overridden by a file beside the exe, so nobody can make
         cdpgate.exe run other code by planting a .jrc next to it. -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation>
                <property>
                    <name>jrexe</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.1.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>exe</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>cdpgate</name>
                            <appId>io.github.cdpai:cdpgate</appId>
                            <fileDescription>cdpgate</fileDescription>
                            <productName>cdpgate</productName>
                            <companyName>cdpai</companyName>
                            <copyright>cdpai contributors</copyright>
                            <icon>${project.basedir}/src/main/jr/cdpgate.ico</icon>
                            <javaVersion>25+</javaVersion>
                            <jvmMode>dll</jvmMode>
                            <vmArgs>
                                <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            </vmArgs>
                            <jarUrl>https://github.com/cdpai/gate/releases/download/v${project.version}/cdpgate.jar</jarUrl>
                            <updateUrl>https://github.com/cdpai/gate/releases/latest/download/cdpgate.update.json</updateUrl>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
