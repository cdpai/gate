<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.cdpai</groupId>
    <artifactId>cdpai-gate-parent</artifactId>
    <version>0.1</version>
    <packaging>pom</packaging>
    <name>gate</name>
    <description>cdpgate: a tray-owned CDP gate for a Chromium browser, and the client library and tools that talk to it.</description>
    <url>https://github.com/cdpai/gate</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>cdpai</id>
            <name>Ivan Velikanov</name>
            <email>ivan.velikanov.dev@gmail.com</email>
            <url>https://github.com/cdpai</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/cdpai/gate</url>
        <connection>scm:git:https://github.com/cdpai/gate.git</connection>
        <developerConnection>scm:git:git@github.com:cdpai/gate.git</developerConnection>
    </scm>

    <modules>
        <module>client</module>
        <module>app</module>
        <module>cli</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- jrexe (app and cli): the exe version (release.ps1 passes X.Y.Z or X.Y.Z-beta.N), its channel, where its jar is published, where its update file lives -->
        <jrexe.version>${project.version}</jrexe.version>
        <jrexe.channel>stable</jrexe.channel>
        <jrexe.release>https://github.com/cdpai/gate/releases/download/v${jrexe.version}</jrexe.release>
        <jrexe.updates>https://leasegate.github.io/cdpgate/update</jrexe.updates>
        <!-- AOT for the cdpgate binary. release.ps1 builds the macOS binaries with false: a JavaFX app crashed in
             AOTLinkedClassBulkLoader on its second start on a Mac (Temurin 25.0.4.1). A stopgap until the cause is found. -->
        <cdpgate.aot>true</cdpgate.aot>
        <picocli.version>4.7.6</picocli.version>
        <jackson.version>2.21.2</jackson.version>
        <leasegate.version>0.2</leasegate.version>
        <javafx.version>27</javafx.version>
        <luvjfx.version>1.0</luvjfx.version>
    </properties>

    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property><name>org.name</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                            <additionalOptions>--no-fonts</additionalOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keyname>${org.gpg.keyname}</keyname>
                            <passphrase>${org.gpg.passphrase}</passphrase>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${org.publishing.server.id}</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
